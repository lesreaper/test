# Root-level Dockerfile for API service
# This file delegates to api/Dockerfile but sets the correct build context
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements from api directory
COPY api/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code from api directory
COPY api/ .

# Expose port
EXPOSE 8000

# Run migrations, seed data, and start server
CMD ["sh", "-c", "alembic upgrade head && python app/scripts/seed.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
