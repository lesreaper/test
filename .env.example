# Copy to ".env" in this directory (never commit .env).

# Required for `api` and for `docker compose up`
OPENAI_API_KEY=sk-...

# Comma-separated origins for browser → API (add your Railway web URL in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Local dev without Docker (two terminals) ---
# Terminal 1 — API:  cd api && cp .env.example .env && # edit OPENAI_API_KEY
#                 uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
# Terminal 2 — Web: cd web && echo 'NEXT_PUBLIC_API_URL=http://localhost:8000' > .env.local && npm run dev
#
# --- Local dev with Docker ---
# docker compose up --build
# Then open http://localhost:3000
